# Copy to .env and fill in to let the demo and evals call the model.
# Without a key, everything already recorded under recordings/ still runs.
ANTHROPIC_API_KEY=

# replay | record | live. record (the default) replays what is recorded and asks the model for the rest.
MODEL_MODE=record
# The default model reads every document. A reading that fails its checks is retried once on the
# escalation model before the statement is held for a person.
MODEL_NAME=claude-sonnet-5-5
MODEL_ESCALATION_NAME=claude-opus-5-5
MODEL_EFFORT=medium
