{
  "name": "payout-verification",
  "version": "0.1.0",
  "private": true,
  "description": "Verifies what carriers paid an agency network against what they owed, and what the network owes each agency.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit && pnpm --filter web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm --filter web test",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "demo:seed": "nest start -- seed",
    "demo:seed:brands": "nest start -- seed --tenant tenants/brand-group --data data/brand-group",
    "demo:reconcile": "nest start -- reconcile",
    "demo:bonus": "nest start -- bonus",
    "eval": "nest start -- eval",
    "admin": "pnpm --filter web build && nest start --entryFile server",
    "admin:api": "nest start --watch --entryFile server",
    "admin:brands": "pnpm --filter web build && TENANT_DIR=tenants/brand-group DATA_DIR=data/brand-group OUT_DIR=out/brand-group EVALS_DIR=out/evals PORT=3001 nest start --entryFile server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/serve-static": "^12.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "nest-commander": "^3.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
