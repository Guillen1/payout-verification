{
  "name": "payout-verification",
  "version": "0.1.0",
  "private": true,
  "description": "Verifies what carriers paid an agency network against what they owed, and what the network owes each agency.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "demo:seed": "tsx src/cli/seed.ts",
    "demo:reconcile": "tsx src/cli/reconcile.ts",
    "eval": "tsx evals/run-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
